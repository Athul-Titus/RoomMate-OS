# ============================================================
# ROOMMATE OS — Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# Application
APP_ENV=local
APP_NAME="ROOMMATE OS"
APP_VERSION=0.1.0

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_real_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://roommate:roommate@localhost:5432/roommate_os
DATABASE_URL_SYNC=postgresql+psycopg2://roommate:roommate@localhost:5432/roommate_os

# Redis
REDIS_URL=redis://localhost:6379/0

# Email Adapter: "console" (local dev) | "resend" (production)
EMAIL_ADAPTER=console
EMAIL_FROM_ADDRESS=no-reply@roommateos.com
EMAIL_FROM_NAME="ROOMMATE OS"
RESEND_API_KEY=

# Storage
STORAGE_ADAPTER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_PRIVATE=roommate-private
STORAGE_BUCKET_PUBLIC=roommate-public
STORAGE_REGION=ap-south-1

# CORS — comma-separated origins
ALLOWED_ORIGINS=["http://localhost:3000"]

# Nominatim (OpenStreetMap geocoding)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RoommateOS/0.1
