# ═══════════════════════════════════════════════════════════
# ROOMMATE OS — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
# ═══════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────
APP_ENV=local
# local | staging | production
APP_NAME=ROOMMATE OS
APP_VERSION=0.1.0

# ── Security ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_64_BYTE_HEX_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://roommate:roommate@localhost:5432/roommate_os
# Sync URL used only by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://roommate:roommate@localhost:5432/roommate_os

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email ───────────────────────────────────────────────────
# In local dev, EMAIL_ADAPTER=console prints emails to stdout.
# For production set EMAIL_ADAPTER=resend and provide key below.
EMAIL_ADAPTER=console
EMAIL_FROM_ADDRESS=no-reply@roommtateos.com
EMAIL_FROM_NAME=ROOMMATE OS
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Object Storage ──────────────────────────────────────────
# In local dev use MinIO (started by docker-compose).
STORAGE_ADAPTER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=roommate_minio
STORAGE_SECRET_KEY=roommate_minio_secret
STORAGE_BUCKET_PRIVATE=roommate-private
STORAGE_BUCKET_PUBLIC=roommate-public
STORAGE_REGION=ap-south-1
# For production on AWS:
# STORAGE_ADAPTER=s3
# STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# STORAGE_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Maps / Geocoding (OpenStreetMap + Nominatim) ────────────
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Use a custom User-Agent per Nominatim usage policy
NOMINATIM_USER_AGENT=RoommateOS/0.1 (contact@roommateos.com)

# ── Background Worker ───────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Web App (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=ROOMMATE OS

